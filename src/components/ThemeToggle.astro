---
---

<button
  id="theme-toggle"
  type="button"
  aria-label="Toggle color theme"
  class="p-2 rounded-lg hover:bg-[var(--color-surface-alt)] transition-colors cursor-pointer"
>
  <svg id="icon-sun" class="hidden w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
    <circle cx="12" cy="12" r="5" />
    <path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42" />
  </svg>
  <svg id="icon-moon" class="hidden w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
  </svg>
  <svg id="icon-system" class="hidden w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
    <rect x="2" y="3" width="20" height="14" rx="2" />
    <path d="M8 21h8M12 17v4" />
  </svg>
</button>

<script>
  type Theme = 'light' | 'dark' | 'system';

  function setupThemeToggle() {
    const btn = document.getElementById('theme-toggle');
    const iconSun = document.getElementById('icon-sun');
    const iconMoon = document.getElementById('icon-moon');
    const iconSystem = document.getElementById('icon-system');

    function getTheme(): Theme {
      return (localStorage.getItem('theme') as Theme) || 'system';
    }

    function applyTheme(theme: Theme) {
      const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      const isDark = theme === 'dark' || (theme === 'system' && prefersDark);
      document.documentElement.classList.toggle('dark', isDark);

      const icons = [iconSun, iconMoon, iconSystem];
      const activeIcon = theme === 'dark' ? iconSun : theme === 'light' ? iconMoon : iconSystem;

      icons.forEach(icon => {
        icon!.classList.add('hidden');
        icon!.classList.remove('entering');
      });

      activeIcon!.classList.remove('hidden');
      activeIcon!.classList.add('entering');
      activeIcon!.addEventListener('animationend', () => {
        activeIcon!.classList.remove('entering');
      }, { once: true });
    }

    function cycleTheme() {
      const order: Theme[] = ['system', 'light', 'dark'];
      const current = getTheme();
      const next = order[(order.indexOf(current) + 1) % order.length];
      localStorage.setItem('theme', next);
      applyTheme(next);
    }

    btn?.addEventListener('click', cycleTheme);
    applyTheme(getTheme());

    window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
      if (getTheme() === 'system') applyTheme('system');
    });
  }

  setupThemeToggle();
  document.addEventListener('astro:after-swap', setupThemeToggle);
</script>
