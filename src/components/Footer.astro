---
const links = [
  { label: 'GitHub', href: 'https://github.com/jptech' },
  { label: 'LinkedIn', href: 'https://linkedin.com/in/parkermitchell' },
  { label: 'Scholar', href: 'https://scholar.google.com/citations?user=bK222y8AAAAJ&hl=en' },
  { label: 'RSS', href: '/rss.xml' },
];
---

<footer class="w-full max-w-2xl mx-auto px-4 sm:px-6 pt-12 pb-8">
  <div class="border-t border-[var(--color-border)] pt-8">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
      <div>
        <p class="text-sm font-mono font-medium text-[var(--color-text)]">Parker Mitchell</p>
        <p class="text-xs text-[var(--color-text-faint)] mt-0.5">
          Hardware/software engineer
        </p>
      </div>
      <div class="flex items-center gap-4">
        {links.map(({ label, href }) => (
          <a
            href={href}
            class="text-sm text-[var(--color-text-muted)] hover:text-[var(--color-text)]
                   transition-colors"
            {...(href.startsWith('http') ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
          >
            {label}
          </a>
        ))}
      </div>
    </div>
    <p class="text-xs text-[var(--color-text-faint)] mt-6">
      &copy; {new Date().getFullYear()} Parker Mitchell. Built with Astro.
    </p>
  </div>
</footer>
