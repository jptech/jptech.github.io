---
interface PostLink {
  id: string;
  data: { title: string };
}

interface Props {
  prev?: PostLink;
  next?: PostLink;
}

const { prev, next } = Astro.props;
---

{(prev || next) && (
  <nav class="mt-12 pt-8 border-t border-[var(--color-border)] grid grid-cols-2 gap-4 text-sm">
    <div>
      {prev && (
        <a href={`/blog/${prev.id}/`}
           class="group block p-4 -m-4 rounded-xl
                  hover:bg-[var(--color-surface-alt)] transition-all duration-200">
          <span class="text-xs text-[var(--color-text-faint)] flex items-center gap-1">
            <svg class="w-3 h-3 transition-transform duration-200 group-hover:-translate-x-0.5"
                 fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path d="M15 19l-7-7 7-7"/>
            </svg>
            Previous
          </span>
          <p class="text-[var(--color-text-muted)] group-hover:text-[var(--color-accent)]
                    transition-colors mt-1 font-medium">
            {prev.data.title}
          </p>
        </a>
      )}
    </div>
    <div class="text-right">
      {next && (
        <a href={`/blog/${next.id}/`}
           class="group block p-4 -m-4 rounded-xl
                  hover:bg-[var(--color-surface-alt)] transition-all duration-200">
          <span class="text-xs text-[var(--color-text-faint)] flex items-center justify-end gap-1">
            Next
            <svg class="w-3 h-3 transition-transform duration-200 group-hover:translate-x-0.5"
                 fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path d="M9 5l7 7-7 7"/>
            </svg>
          </span>
          <p class="text-[var(--color-text-muted)] group-hover:text-[var(--color-accent)]
                    transition-colors mt-1 font-medium">
            {next.data.title}
          </p>
        </a>
      )}
    </div>
  </nav>
)}
