---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Not Found" description="Page not found.">
  <div class="flex flex-col items-center justify-center py-24 text-center">
    <p class="text-6xl font-mono font-bold text-[var(--color-accent)] mb-4">404</p>
    <h1 class="text-xl font-semibold mb-2">Page not found</h1>
    <p class="text-sm text-[var(--color-text-muted)] mb-8">
      The page you're looking for doesn't exist or has been moved.
    </p>
    <a
      href="/"
      class="text-sm font-medium text-[var(--color-accent)] hover:text-[var(--color-accent-hover)]
             transition-colors underline underline-offset-4 decoration-[var(--color-accent)]/30
             hover:decoration-[var(--color-accent)]"
    >
      &larr; Back to home
    </a>
  </div>
</BaseLayout>
