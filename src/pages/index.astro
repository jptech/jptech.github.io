---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import CategoryFilter from '../components/CategoryFilter.astro';
import { getReadingTime } from '../utils/reading-time';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title="Home" description="Technical writing on FPGA design, hardware engineering, and software systems.">
  <div class="mb-12">
    <h1 class="text-2xl font-bold tracking-tight mb-2">
      Hey, I'm <span class="text-[var(--color-accent)]">Parker</span>
    </h1>
    <p class="text-[var(--color-text-muted)] leading-relaxed">
      Hardware/software engineer writing about FPGA design, hardware development tooling, and hw/sw codesign.
    </p>
    <div class="mt-6 h-px bg-gradient-to-r from-[var(--color-accent)] via-[var(--color-border)] to-transparent"></div>
  </div>

  {posts.length > 0 ? (
    <>
      <CategoryFilter />
      <div class="post-list divide-y divide-[var(--color-border-subtle)]">
        {posts.map((post) => (
          <PostCard
            title={post.data.title}
            description={post.data.description}
            date={post.data.date}
            category={post.data.category}
            tags={post.data.tags}
            slug={post.id}
            readingTime={getReadingTime(post.body ?? '')}
          />
        ))}
      </div>
    </>
  ) : (
    <p class="text-sm text-[var(--color-text-faint)]">Posts coming soon.</p>
  )}
</BaseLayout>
